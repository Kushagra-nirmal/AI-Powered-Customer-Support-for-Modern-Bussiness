# ==============================================================================
# Production-Grade Agentic AI Customer Support System (SupportAI & JARVIS)
# Environment Configuration Template
# Author: Nirmal Sharma
# ==============================================================================

# --- Application Runtime Settings ---
APP_ENV=development                       # development, staging, production, or test
PROJECT_NAME="SupportAI & JARVIS"
VERSION=1.0.0
DEBUG=false
PORT=8000
HOST=0.0.0.0

# --- API & Security Configuration ---
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,https://*.trycloudflare.com"

# --- Primary & Fallback LLM Providers ---
LLM_PROVIDER=gemini                       # gemini or openai
GEMINI_API_KEY="your-google-gemini-api-key-here"
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite   # Options: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-3.8-pro
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3

# --- Optional OpenAI Secondary Fallback ---
OPENAI_API_KEY="your-openai-api-key-here"
SECONDARY_LLM_MODEL=gpt-4o-mini

# --- JWT Authentication & Session Token Settings ---
JWT_SECRET_KEY="generate-a-secure-random-64-char-hex-secret-here"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# --- PostgreSQL Database (Food Order & Ticketing Cluster) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433                        # 5433 for local isolated pgdata or 5432 for Docker
POSTGRES_DB=food_order_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# --- Langfuse & Observability Telemetry ---
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Rate Limiting Safeguards ---
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="60 per minute"
RATE_LIMIT_CHAT_STREAM="30 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="30 per minute"

# --- Structured Logging & Audit Trail ---
LOG_DIR=logs
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                          # json (production) or console (development)

# --- Multimodal & Voice Audio Settings ---
ENABLE_JARVIS_VOICE=true
DEFAULT_TTS_VOICE=en-GB-RyanNeural
TTS_ACOUSTIC_PROFILE=hud                 # hud (Iron Man Mark VII), hologram, or clean
